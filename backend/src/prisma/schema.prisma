// EduCore — Student Management System
// Normalized relational schema covering PRD Modules 1–20.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

