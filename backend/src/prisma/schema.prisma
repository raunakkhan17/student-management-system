// MODULE 13 — TRANSPORT
// ============================================================

model Vehicle {
  id                 String        @id @default(uuid()) @db.Uuid
  registrationNumber String        @unique
  make               String
  model              String
  type               VehicleType   @default(BUS)
  capacity           Int
  manufactureYear    Int?
  insuranceExpiry    DateTime?     @db.Date
  fitnessExpiry      DateTime?     @db.Date
  pollutionExpiry    DateTime?     @db.Date
  status             VehicleStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  routes           TransportRoute[]
  maintenanceLogs  VehicleMaintenance[]

  @@index([status])
  @@map("vehicles")
}

model Driver {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String?      @unique @db.Uuid
  employeeCode    String       @unique
  firstName       String
  lastName        String
  phone           String
  alternatePhone  String?
  licenseNumber   String       @unique
  licenseExpiry   DateTime     @db.Date
  address         String?
  experienceYears Int          @default(0)
  status          DriverStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  routes TransportRoute[]

  @@index([status])
  @@map("drivers")
}

model TransportRoute {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  code          String    @unique
  startPoint    String
  endPoint      String
  distanceKm    Decimal?  @db.Decimal(6, 2)
  estimatedMins Int?
  fare          Decimal   @default(0) @db.Decimal(10, 2)
  vehicleId     String?   @db.Uuid
  driverId      String?   @db.Uuid
  attendantName String?
  attendantPhone String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver  Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)

  stops       RouteStop[]
  allocations StudentTransport[]

  @@index([isActive])
  @@map("transport_routes")
}

model RouteStop {
  id         String   @id @default(uuid()) @db.Uuid
  routeId    String   @db.Uuid
  name       String
  sequence   Int
  pickupTime String
  dropTime   String
  landmark   String?
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  route TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  allocations StudentTransport[]

  @@unique([routeId, sequence])
  @@index([routeId])
  @@map("route_stops")
}

model StudentTransport {
  id             String           @id @default(uuid()) @db.Uuid
  studentId      String           @db.Uuid
  routeId        String           @db.Uuid
  stopId         String           @db.Uuid
  academicYearId String           @db.Uuid
  startDate      DateTime         @db.Date
  endDate        DateTime?        @db.Date
  fare           Decimal          @default(0) @db.Decimal(10, 2)
  status         AllocationStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student      Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route        TransportRoute @relation(fields: [routeId], references: [id], onDelete: Restrict)
  stop         RouteStop      @relation(fields: [stopId], references: [id], onDelete: Restrict)
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  @@unique([studentId, academicYearId, status])
  @@index([routeId, status])
  @@map("student_transports")
}

model VehicleMaintenance {
  id              String          @id @default(uuid()) @db.Uuid
  vehicleId       String          @db.Uuid
  type            MaintenanceType
  description     String
  serviceDate     DateTime        @db.Date
  nextServiceDate DateTime?       @db.Date
  cost            Decimal         @default(0) @db.Decimal(10, 2)
  vendor          String?
  odometerReading Int?
  performedById   String?         @db.Uuid
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  vehicle     Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  performedBy User?   @relation("MaintenancePerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([vehicleId, serviceDate])
  @@map("vehicle_maintenance")
}

// ============================================================
// MODULE 14 — LEAVE MANAGEMENT
