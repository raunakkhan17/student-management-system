  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  PARENT
  ACCOUNTANT
  LIBRARIAN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum AppModule {
  DASHBOARD
  USERS
  STUDENTS
  TEACHERS
  ACADEMICS
  ATTENDANCE
  EXAMS
  ASSIGNMENTS
  TIMETABLE
  FEES
  LIBRARY
  HOSTEL
  TRANSPORT
  LEAVE
  NOTICES
  COMMUNICATION
  DOCUMENTS
  REPORTS
  SETTINGS
  AUDIT_LOGS
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  APPROVE
  EXPORT
  ASSIGN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
